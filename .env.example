# ------------------------------------------------------------------
# Workhorse Digital — environment variables
# Copy to .env and fill in. NEXT_PUBLIC_* values are baked in at build time.
# ------------------------------------------------------------------

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://workhorsedigital.co
NEXT_PUBLIC_PHONE=+15550000000
NEXT_PUBLIC_PHONE_DISPLAY=(555) 000-0000
NEXT_PUBLIC_EMAIL=hello@workhorsedigital.co
# Calendly / Google Calendar booking link for "Book a 15-Min Call". Falls back to /contact if empty.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Analytics ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Database (Hostinger MySQL) ---
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# --- Lead notification email (SMTP; use port 465 or 587, Hostinger blocks 25) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=leads@workhorsedigital.co
SMTP_PASS=
SMTP_FROM=leads@workhorsedigital.co
LEAD_NOTIFY_EMAIL=hello@workhorsedigital.co

# --- Auth (Phase 2). Generate AUTH_SECRET with: openssl rand -base64 32 ---
AUTH_SECRET=
ENABLE_APP_LOGIN=false
